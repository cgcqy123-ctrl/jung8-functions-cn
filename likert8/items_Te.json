    {"id": "Te-01", "fn": "Te", "reverse": false, "domain": "家庭亲戚",
     "text": "搬家你先列时间表，谁搬哪间写清楚。"},
    {"id": "Te-02", "fn": "Te", "reverse": false, "domain": "家庭亲戚",
     "text": "过年回谁家、哪天走，你排成一张表。"},
    {"id": "Te-03", "fn": "Te", "reverse": true, "domain": "家庭亲戚",
