  "items": [
    {"id": "Se-01", "fn": "Se", "reverse": false, "domain": "家庭亲戚",
     "text": "全家出去玩，路上临时改道，你第一个说那就走这条。"},
    {"id": "Se-02", "fn": "Se", "reverse": false, "domain": "家庭亲戚",
     "text": "年夜饭桌上菜不够，你起身就去厨房张罗。"},
    {"id": "Se-03", "fn": "Se", "reverse": true, "domain": "家庭亲戚",
     "text": "全家出游怎么走，你想按原来定好的来。"},

    {"id": "Se-04", "fn": "Se", "reverse": false, "domain": "职场办公",
     "text": "客户当面改需求，你直接在会议室里改给他看。"},
    {"id": "Se-05", "fn": "Se", "reverse": false, "domain": "职场办公",
     "text": "盘点时货架摆错，一眼就被你看出来。"},
    {"id": "Se-06", "fn": "Se", "reverse": true, "domain": "职场办公",
     "text": "团建爬山，你跟着队伍慢慢走，不太看路。"},

    {"id": "Se-07", "fn": "Se", "reverse": false, "domain": "学习考试",
     "text": "学游泳你不看教程，先下水试。"},
    {"id": "Se-08", "fn": "Se", "reverse": true, "domain": "学习考试",
     "text": "上手之前，你得把教程完整看一遍才敢动。"},

    {"id": "Se-09", "fn": "Se", "reverse": false, "domain": "社交人情",
     "text": "一桌人都不动，你先招呼点菜。"},
    {"id": "Se-10", "fn": "Se", "reverse": false, "domain": "社交人情",
     "text": "桌游规则还没讲完，你已经摸起牌来试。"},

    {"id": "Se-11", "fn": "Se", "reverse": false, "domain": "消费生活",
     "text": "逛家电卖场，你先上手把机器摸一圈。"},
    {"id": "Se-12", "fn": "Se", "reverse": true, "domain": "消费生活",
     "text": "买东西你翻翻参数就下单，懒得去店里看。"},

    {"id": "Se-13", "fn": "Se", "reverse": false, "domain": "冲突矛盾",
     "text": "楼上半夜还在响，你披上衣服上楼敲门。"},
    {"id": "Se-14", "fn": "Se", "reverse": true, "domain": "冲突矛盾",
     "text": "买菜被少称了，你回家才想起来该说。"},

    {"id": "Se-15", "fn": "Se", "reverse": false, "domain": "兴趣娱乐",
     "text": "做菜你靠手感撒盐，尝一口再补。"},
    {"id": "Se-16", "fn": "Se", "reverse": true, "domain": "兴趣娱乐",
     "text": "做菜你按菜谱称克数、掐着表。"},

    {"id": "Se-17", "fn": "Se", "reverse": false, "domain": "信息媒体",
     "text": "新手机上市，你先去店里摸一遍。"},

    {"id": "Se-18", "fn": "Se", "reverse": false, "domain": "亲密关系",
     "text": "对方不高兴，你拉他出门走走。"},

    {"id": "Se-19", "fn": "Se", "reverse": false, "domain": "身体健康",
