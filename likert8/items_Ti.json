    {"id": "Ti-10", "fn": "Ti", "reverse": true, "domain": "社交人情",
     "text": "聊天里一个词用得不准确，你不太在意。"},

    {"id": "Ti-11", "fn": "Ti", "reverse": false, "domain": "消费生活",
     "text": "参数之间的取舍，你会先弄清原理再选。"},
    {"id": "Ti-12", "fn": "Ti", "reverse": true, "domain": "消费生活",
     "text": "保修条款你扫一眼就签，不太抠字眼。"},

    {"id": "Ti-13", "fn": "Ti", "reverse": false, "domain": "冲突矛盾",
     "text": "争执你会拆成哪些是事实、哪些是判断。"},
    {"id": "Ti-14", "fn": "Ti", "reverse": true, "domain": "冲突矛盾",
     "text": "谁对谁错你不细究，先把事放过去。"},

    {"id": "Ti-15", "fn": "Ti", "reverse": false, "domain": "兴趣娱乐",
