    {"id": "Ti-16", "fn": "Ti", "reverse": false, "domain": "兴趣娱乐",
     "text": "玩之前你会先把规则完整读一遍。"},

    {"id": "Ti-17", "fn": "Ti", "reverse": false, "domain": "信息媒体",
