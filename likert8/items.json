{
  "meta": {
    "version": "v3.0",
    "scale": 7,
    "items": 152,
    "plan": "8 个功能 × 19 题；每题 7 点同意度；每功能 6 题反向"
  },
  "items": [
    {
      "id": "Se-01",
      "fn": "Se",
      "reverse": false,
      "domain": "家庭亲戚",
      "text": "全家自驾途中临时改道，你马上看路牌问往哪拐。"
    },
    {
      "id": "Se-02",
      "fn": "Se",
      "reverse": false,
      "domain": "家庭亲戚",
      "text": "年夜饭桌上菜还没齐，你就挽袖子现张罗起来。"
    },
    {
      "id": "Se-03",
      "fn": "Se",
      "reverse": true,
      "domain": "家庭亲戚",
      "text": "全家自驾途中临时改道，你先打电话问清原来的安排。"
    },
    {
      "id": "Se-04",
      "fn": "Se",
      "reverse": false,
      "domain": "职场办公",
      "text": "客户当场推翻方案，你在会议室就着白板改。"
    },
    {
      "id": "Se-05",
      "fn": "Se",
      "reverse": false,
      "domain": "职场办公",
      "text": "仓库盘点时你一眼看出货架上有箱摆错了。"
    },
    {
      "id": "Se-06",
      "fn": "Se",
      "reverse": true,
      "domain": "职场办公",
      "text": "团建爬山你跟着队伍走，脚下的路交给别人看。"
    },
    {
      "id": "Se-07",
      "fn": "Se",
      "reverse": false,
      "domain": "学习考试",
      "text": "学游泳你不看教程，先下水扶着池边蹬腿。"
    },
    {
      "id": "Se-08",
      "fn": "Se",
      "reverse": true,
      "domain": "学习考试",
      "text": "学游泳前你先把教程视频看完，才肯下水。"
    },
    {
      "id": "Se-09",
      "fn": "Se",
      "reverse": false,
      "domain": "社交人情",
      "text": "饭局上你拿过菜单，边翻边问大家吃什么。"
    },
    {
      "id": "Se-10",
      "fn": "Se",
      "reverse": false,
      "domain": "社交人情",
      "text": "朋友拿出新桌游，你先抓牌试一把再听规则。"
    },
    {
      "id": "Se-11",
      "fn": "Se",
      "reverse": false,
      "domain": "消费生活",
      "text": "逛家电卖场你打开冰箱门，摸内壁听声音。"
    },
    {
      "id": "Se-12",
      "fn": "Se",
      "reverse": true,
      "domain": "消费生活",
      "text": "买冰箱前你翻参数做对比，到了卖场也没上手看。"
    },
    {
      "id": "Se-13",
      "fn": "Se",
      "reverse": false,
      "domain": "冲突矛盾",
      "text": "楼上半夜还在响，你披上衣服上楼敲门当面说。"
    },
    {
      "id": "Se-14",
      "fn": "Se",
      "reverse": true,
      "domain": "冲突矛盾",
      "text": "菜市场少称了，你心里记一下，回家再想办法。"
    },
    {
      "id": "Se-15",
      "fn": "Se",
      "reverse": false,
      "domain": "兴趣娱乐",
      "text": "做菜你靠手感撒盐，尝一口再补一点。"
    },
    {
      "id": "Se-16",
      "fn": "Se",
      "reverse": true,
      "domain": "兴趣娱乐",
      "text": "做菜你按菜谱称好克数，再一样一样下锅。"
    },
    {
      "id": "Se-17",
      "fn": "Se",
      "reverse": false,
      "domain": "信息媒体",
      "text": "新手机上市，你先去店里把它拿在手上转两圈。"
    },
    {
      "id": "Se-18",
      "fn": "Se",
      "reverse": false,
      "domain": "亲密关系",
      "text": "对方情绪不好，你不劝，拉他出门走一段。"
    },
    {
      "id": "Se-19",
      "fn": "Se",
      "reverse": false,
      "domain": "身体健康",
      "text": "身体不舒服，你先说清是哪儿疼、怎么个疼法。"
    },
    {
      "id": "Si-01",
      "fn": "Si",
      "reverse": false,
      "domain": "家庭亲戚",
      "text": "过年走亲戚，你按往年的顺序一家一家去。"
    },
    {
      "id": "Si-02",
      "fn": "Si",
      "reverse": false,
      "domain": "家庭亲戚",
      "text": "妈妈的旧菜谱，你照着上面的火候和顺序做。"
    },
    {
      "id": "Si-03",
      "fn": "Si",
      "reverse": true,
      "domain": "家庭亲戚",
      "text": "家里的东西放哪儿你不太在意，找的时候再翻。"
    },
    {
      "id": "Si-04",
      "fn": "Si",
      "reverse": false,
      "domain": "职场办公",
      "text": "做报表你还是沿用上季度那份模板的格式。"
    },
    {
      "id": "Si-05",
      "fn": "Si",
      "reverse": false,
      "domain": "职场办公",
      "text": "公司流程你一步步照着走，跳一步心里不踏实。"
    },
    {
      "id": "Si-06",
      "fn": "Si",
      "reverse": true,
      "domain": "职场办公",
      "text": "新项目你不翻旧资料，直接从头摸一遍。"
    },
    {
      "id": "Si-07",
      "fn": "Si",
      "reverse": true,
      "domain": "学习考试",
      "text": "复习你不翻旧笔记，另找一套方法从头试。"
    },
    {
      "id": "Si-08",
      "fn": "Si",
      "reverse": false,
      "domain": "学习考试",
      "text": "考试你先按熟的那套时间分配往下答。"
    },
    {
      "id": "Si-09",
      "fn": "Si",
      "reverse": false,
      "domain": "社交人情",
      "text": "老朋友见面，你还是约那家去了很多年的老馆子。"
    },
    {
      "id": "Si-10",
      "fn": "Si",
      "reverse": true,
      "domain": "社交人情",
      "text": "饭桌上你换个新段子讲，老段子自己都想不起来。"
    },
    {
      "id": "Si-11",
      "fn": "Si",
      "reverse": false,
      "domain": "消费生活",
      "text": "买酱油你伸手就拿一直吃的那个牌子。"
    },
    {
      "id": "Si-12",
      "fn": "Si",
      "reverse": false,
      "domain": "消费生活",
      "text": "换新手机，你先去把旧手机里的设置一项项对回来。"
    },
    {
      "id": "Si-13",
      "fn": "Si",
      "reverse": false,
      "domain": "冲突矛盾",
      "text": "邻里有点摩擦，你按以前那回的办法去处理。"
    },
    {
      "id": "Si-14",
      "fn": "Si",
      "reverse": true,
      "domain": "冲突矛盾",
      "text": "跟同事闹别扭，你不去想上回，只谈这次的事。"
    },
    {
      "id": "Si-15",
      "fn": "Si",
      "reverse": false,
      "domain": "兴趣娱乐",
      "text": "跑步你顺着那条走熟的路线，心里有数。"
    },
    {
      "id": "Si-16",
      "fn": "Si",
      "reverse": true,
      "domain": "兴趣娱乐",
      "text": "做菜你不看量杯和计时器，随手放随手炒。"
    },
    {
      "id": "Si-17",
      "fn": "Si",
      "reverse": false,
      "domain": "信息媒体",
      "text": "看到一条传言，你想起前几年传过的那版。"
    },
    {
      "id": "Si-18",
      "fn": "Si",
      "reverse": false,
      "domain": "亲密关系",
      "text": "对方不吃什么、几点睡，你都记在心里。"
    },
    {
      "id": "Si-19",
      "fn": "Si",
      "reverse": false,
      "domain": "身体健康",
      "text": "换季时你会留意身上反应跟往年像不像。"
    },
    {
      "id": "Ne-01",
      "fn": "Ne",
      "reverse": false,
      "domain": "家庭亲戚",
      "text": "装修想试混搭，北欧的墙配旧木料地板，阳台也想掺一手。"
    },
    {
      "id": "Ne-02",
      "fn": "Ne",
      "reverse": false,
      "domain": "家庭亲戚",
      "text": "孩子问天为什么蓝，你从光的散射扯到海和晚霞，话还没完。"
    },
    {
      "id": "Ne-03",
      "fn": "Ne",
      "reverse": true,
      "domain": "家庭亲戚",
      "text": "旧家具你就按原来的用处用，没想过改成别的样子。"
    },
    {
      "id": "Ne-04",
      "fn": "Ne",
      "reverse": false,
      "domain": "职场办公",
      "text": "会上你一口气抛出三个方向，还顺手补了两条别的路。"
    },
    {
      "id": "Ne-05",
      "fn": "Ne",
      "reverse": false,
      "domain": "职场办公",
      "text": "给产品想点子，你专挑不正经的路子试，再看哪个能成。"
    },
    {
      "id": "Ne-06",
      "fn": "Ne",
      "reverse": true,
      "domain": "职场办公",
      "text": "开会你只讲定好的那个方向，别的一条都不提。"
    },
    {
      "id": "Ne-07",
      "fn": "Ne",
      "reverse": false,
      "domain": "学习考试",
      "text": "啃一个概念，你会想到别的领域也有同一套东西在转。"
    },
    {
      "id": "Ne-08",
      "fn": "Ne",
      "reverse": true,
      "domain": "学习考试",
      "text": "记概念你就按书上那一章记下来，不往别的地方联。"
    },
    {
      "id": "Ne-09",
      "fn": "Ne",
      "reverse": false,
      "domain": "社交人情",
      "text": "聊着聊着，你从天气跳到谁家的事，再跳到新开的店。"
    },
    {
      "id": "Ne-10",
      "fn": "Ne",
      "reverse": true,
      "domain": "社交人情",
      "text": "聊天时你守着同一个话题往下说，不往旁边岔。"
    },
    {
      "id": "Ne-11",
      "fn": "Ne",
      "reverse": false,
      "domain": "消费生活",
      "text": "逛超市专看新品，看完就琢磨家里哪块地方能用上。"
    },
    {
      "id": "Ne-12",
      "fn": "Ne",
      "reverse": true,
      "domain": "消费生活",
      "text": "逛超市只拿清单上的，新品柜台一眼不看就走过去。"
    },
    {
      "id": "Ne-13",
      "fn": "Ne",
      "reverse": false,
      "domain": "冲突矛盾",
      "text": "吵起来的时候，你提出第三条路，两边都没想过的。"
    },
    {
      "id": "Ne-14",
      "fn": "Ne",
      "reverse": false,
      "domain": "冲突矛盾",
      "text": "矛盾里你会替对方想几种处境，还想过换个说法。"
    },
    {
      "id": "Ne-15",
      "fn": "Ne",
      "reverse": false,
      "domain": "兴趣娱乐",
      "text": "想同时学三样乐器，还给每样找了个入门的法子。"
    },
    {
      "id": "Ne-16",
      "fn": "Ne",
      "reverse": true,
      "domain": "兴趣娱乐",
      "text": "旅行前你把路线定成一套，路上不再琢磨别的走法。"
    },
    {
      "id": "Ne-17",
      "fn": "Ne",
      "reverse": false,
      "domain": "信息媒体",
      "text": "看到新技术新闻，你先想它还能用在哪，能替掉哪些活。"
    },
    {
      "id": "Ne-18",
      "fn": "Ne",
      "reverse": false,
      "domain": "亲密关系",
      "text": "计划约会你想换花样，吃完饭还能骑车、看展，再去别处。"
    },
    {
      "id": "Ne-19",
      "fn": "Ne",
      "reverse": false,
      "domain": "身体健康",
      "text": "身体一不舒服，你脑子里先冒出一串可能的原因。"
    },
    {
      "id": "Ni-01",
      "fn": "Ni",
      "reverse": false,
      "domain": "家庭亲戚",
      "text": "看亲戚家孩子，你会想他十年后大概走成什么样。"
    },
    {
      "id": "Ni-02",
      "fn": "Ni",
      "reverse": false,
      "domain": "家庭亲戚",
      "text": "家里闹矛盾，你会想根子其实在很早以前的一件小事上。"
    },
    {
      "id": "Ni-03",
      "fn": "Ni",
      "reverse": true,
      "domain": "家庭亲戚",
      "text": "亲戚家的事你只看眼前这一件，不往以后想。"
    },
    {
      "id": "Ni-04",
      "fn": "Ni",
      "reverse": false,
      "domain": "职场办公",
      "text": "你会判断这个行业三年后大概会变成什么样。"
    },
    {
      "id": "Ni-05",
      "fn": "Ni",
      "reverse": false,
      "domain": "职场办公",
      "text": "项目刚立项，你就能说出它最后可能死在哪一步。"
    },
    {
      "id": "Ni-06",
      "fn": "Ni",
      "reverse": true,
      "domain": "职场办公",
      "text": "项目你只关心这周要做完的那部分。"
    },
    {
      "id": "Ni-07",
      "fn": "Ni",
      "reverse": false,
      "domain": "学习考试",
      "text": "读完一本书，你能用一句话说清它到底在讲什么。"
    },
    {
      "id": "Ni-08",
      "fn": "Ni",
      "reverse": true,
      "domain": "学习考试",
      "text": "复习时你按章节顺序过，不太想整门课的主线。"
    },
    {
      "id": "Ni-09",
      "fn": "Ni",
      "reverse": false,
      "domain": "社交人情",
      "text": "见一个人第一面，你心里就有个整体判断。"
    },
    {
      "id": "Ni-10",
      "fn": "Ni",
      "reverse": true,
      "domain": "社交人情",
      "text": "一群人待着时，你只顾说自己的，不太管气氛。"
    },
    {
      "id": "Ni-11",
      "fn": "Ni",
      "reverse": false,
      "domain": "消费生活",
      "text": "买大件时你会想这东西过几年会不会过时。"
    },
    {
      "id": "Ni-12",
      "fn": "Ni",
      "reverse": true,
      "domain": "消费生活",
      "text": "买东西你只看现在用不用得上。"
    },
    {
      "id": "Ni-13",
      "fn": "Ni",
      "reverse": false,
      "domain": "冲突矛盾",
      "text": "争执里你能指出两边真正的分歧在哪。"
    },
    {
      "id": "Ni-14",
      "fn": "Ni",
      "reverse": true,
      "domain": "冲突矛盾",
      "text": "争执里你只回应他最后说的那一句。"
    },
    {
      "id": "Ni-15",
      "fn": "Ni",
      "reverse": false,
      "domain": "兴趣娱乐",
      "text": "看完一部电影，你想的是它真正在讲什么。"
    },
    {
      "id": "Ni-16",
      "fn": "Ni",
      "reverse": false,
      "domain": "兴趣娱乐",
      "text": "听一首歌，你脑子里会浮出一个画面。"
    },
    {
      "id": "Ni-17",
      "fn": "Ni",
      "reverse": false,
      "domain": "信息媒体",
      "text": "一条新闻你会想它背后正往哪个方向走。"
    },
    {
      "id": "Ni-18",
      "fn": "Ni",
      "reverse": false,
      "domain": "亲密关系",
      "text": "关系里你常预感到这样下去会走到哪。"
    },
    {
      "id": "Ni-19",
      "fn": "Ni",
      "reverse": false,
      "domain": "身体健康",
      "text": "长期累的时候，你觉得身体在提示你什么。"
    },
    {
      "id": "Te-01",
      "fn": "Te",
      "reverse": false,
      "domain": "家庭亲戚",
      "text": "搬家前你先列好时间表和分工，谁搬哪间都写清。"
    },
    {
      "id": "Te-02",
      "fn": "Te",
      "reverse": false,
      "domain": "家庭亲戚",
      "text": "过年回谁家、哪天走，你排成一张表。"
    },
    {
      "id": "Te-03",
      "fn": "Te",
      "reverse": true,
      "domain": "家庭亲戚",
      "text": "家里出游你到了再商量去哪，事先不定计划。"
    },
    {
      "id": "Te-04",
      "fn": "Te",
      "reverse": false,
      "domain": "职场办公",
      "text": "接到任务，你先拆成步骤和截止时间。"
    },
    {
      "id": "Te-05",
      "fn": "Te",
      "reverse": false,
      "domain": "职场办公",
      "text": "开会你负责收口：谁做、什么时候交。"
    },
    {
      "id": "Te-06",
      "fn": "Te",
      "reverse": true,
      "domain": "职场办公",
      "text": "项目推进你走一步看一步，不排节点。"
    },
    {
      "id": "Te-07",
      "fn": "Te",
      "reverse": false,
      "domain": "学习考试",
      "text": "备考你先排一张到考前的计划表。"
    },
    {
      "id": "Te-08",
      "fn": "Te",
      "reverse": true,
      "domain": "学习考试",
      "text": "复习你翻到哪算哪，不做进度安排。"
    },
    {
      "id": "Te-09",
      "fn": "Te",
      "reverse": false,
      "domain": "社交人情",
      "text": "组织同学聚会，你把时间、人数、地点定死。"
    },
    {
      "id": "Te-10",
      "fn": "Te",
      "reverse": false,
      "domain": "社交人情",
      "text": "群里收钱办事，你会把账目和进度贴出来。"
    },
    {
      "id": "Te-11",
      "fn": "Te",
      "reverse": false,
      "domain": "消费生活",
      "text": "买大件你做一张比价表，参数价格一起看。"
    },
    {
      "id": "Te-12",
      "fn": "Te",
      "reverse": true,
      "domain": "消费生活",
      "text": "买东西你看着顺眼就下单，不比价。"
    },
    {
      "id": "Te-13",
      "fn": "Te",
      "reverse": false,
      "domain": "冲突矛盾",
      "text": "吵完你把规矩重写一遍，免得再吵。"
    },
    {
      "id": "Te-14",
      "fn": "Te",
      "reverse": true,
      "domain": "冲突矛盾",
      "text": "有矛盾你等它自己过去，不另定规矩。"
    },
    {
      "id": "Te-15",
      "fn": "Te",
      "reverse": false,
      "domain": "兴趣娱乐",
      "text": "出去玩你先把每天的行程排出来。"
    },
    {
      "id": "Te-16",
      "fn": "Te",
      "reverse": true,
      "domain": "兴趣娱乐",
      "text": "组队打游戏，你等别人安排位置，自己不动手分。"
    },
    {
      "id": "Te-17",
      "fn": "Te",
      "reverse": false,
      "domain": "信息媒体",
      "text": "看新政策你先找关键条款和执行时间。"
    },
    {
      "id": "Te-18",
      "fn": "Te",
      "reverse": false,
      "domain": "亲密关系",
