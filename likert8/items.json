  "items": [
    {
      "id": "Se-01",
      "fn": "Se",
      "reverse": false,
      "domain": "家庭亲戚",
      "text": "全家出去玩，路上临时改道，你第一个说那就走这条。"
    },
    {
      "id": "Se-02",
      "fn": "Se",
      "reverse": false,
      "domain": "家庭亲戚",
      "text": "年夜饭桌上菜不够，你起身就去厨房张罗。"
    },
    {
      "id": "Se-03",
      "fn": "Se",
      "reverse": true,
      "domain": "家庭亲戚",
      "text": "全家出游怎么走，你想按原来定好的来。"
    },
    {
      "id": "Se-04",
      "fn": "Se",
      "reverse": false,
      "domain": "职场办公",
      "text": "客户当面改需求，你直接在会议室里改给他看。"
    },
    {
      "id": "Se-05",
      "fn": "Se",
      "reverse": false,
      "domain": "职场办公",
      "text": "盘点时货架摆错，一眼就被你看出来。"
    },
    {
      "id": "Se-06",
      "fn": "Se",
      "reverse": true,
      "domain": "职场办公",
      "text": "团建爬山，你跟着队伍慢慢走，不太看路。"
    },
    {
      "id": "Se-07",
      "fn": "Se",
      "reverse": false,
      "domain": "学习考试",
      "text": "学游泳你不看教程，先下水试。"
    },
    {
      "id": "Se-08",
      "fn": "Se",
      "reverse": true,
      "domain": "学习考试",
      "text": "上手之前，你得把教程完整看一遍才敢动。"
    },
    {
      "id": "Se-09",
      "fn": "Se",
      "reverse": false,
      "domain": "社交人情",
      "text": "一桌人都不动，你先招呼点菜。"
    },
    {
      "id": "Se-10",
      "fn": "Se",
      "reverse": false,
      "domain": "社交人情",
      "text": "桌游规则还没讲完，你已经摸起牌来试。"
    },
    {
      "id": "Se-11",
      "fn": "Se",
      "reverse": false,
      "domain": "消费生活",
      "text": "逛家电卖场，你先上手把机器摸一圈。"
    },
    {
      "id": "Se-12",
      "fn": "Se",
      "reverse": true,
      "domain": "消费生活",
      "text": "买东西你翻翻参数就下单，懒得去店里看。"
    },
    {
      "id": "Se-13",
      "fn": "Se",
      "reverse": false,
      "domain": "冲突矛盾",
      "text": "楼上半夜还在响，你披上衣服上楼敲门。"
    },
    {
      "id": "Se-14",
      "fn": "Se",
      "reverse": true,
      "domain": "冲突矛盾",
      "text": "买菜被少称了，你回家才想起来该说。"
    },
    {
      "id": "Se-15",
      "fn": "Se",
      "reverse": false,
      "domain": "兴趣娱乐",
      "text": "做菜你靠手感撒盐，尝一口再补。"
    },
    {
      "id": "Se-16",
      "fn": "Se",
      "reverse": true,
      "domain": "兴趣娱乐",
      "text": "做菜你按菜谱称克数、掐着表。"
    },
    {
      "id": "Se-17",
      "fn": "Se",
      "reverse": false,
      "domain": "信息媒体",
      "text": "新手机上市，你先去店里摸一遍。"
    },
    {
      "id": "Se-18",
      "fn": "Se",
      "reverse": false,
      "domain": "亲密关系",
      "text": "对方不高兴，你拉他出门走走。"
    },
    {
      "id": "Se-19",
      "fn": "Se",
      "reverse": false,
      "domain": "身体健康",
      "text": "身上不舒服，你先说清哪儿疼、怎么个疼法。"
    },
    {
      "id": "Si-01",
      "fn": "Si",
      "reverse": false,
      "domain": "家庭亲戚",
      "text": "过年走亲戚，你按往年的顺序来才顺。"
    },
    {
      "id": "Si-02",
      "fn": "Si",
      "reverse": false,
      "domain": "家庭亲戚",
      "text": "妈妈的旧菜谱，你照着上面的量做。"
    },
    {
      "id": "Si-03",
      "fn": "Si",
      "reverse": true,
      "domain": "家庭亲戚",
      "text": "家里的东西放哪儿，你从来不记。"
    },
    {
      "id": "Si-04",
      "fn": "Si",
      "reverse": false,
      "domain": "职场办公",
      "text": "做报表你沿用上季度那套模板。"
    },
    {
      "id": "Si-05",
      "fn": "Si",
      "reverse": false,
      "domain": "职场办公",
      "text": "公司的流程你一步一步走，不跳步。"
    },
    {
      "id": "Si-06",
      "fn": "Si",
      "reverse": true,
      "domain": "职场办公",
      "text": "新项目你不翻旧资料，从头摸一遍。"
    },
    {
      "id": "Si-07",
      "fn": "Si",
      "reverse": false,
      "domain": "学习考试",
      "text": "复习还是那套笔记法，换了不顺手。"
    },
    {
      "id": "Si-08",
      "fn": "Si",
      "reverse": true,
      "domain": "学习考试",
      "text": "复习你每次换新方法，旧的不用。"
    },
    {
      "id": "Si-09",
      "fn": "Si",
      "reverse": false,
      "domain": "社交人情",
      "text": "老朋友见面，还是去那家老馆子。"
    },
    {
      "id": "Si-10",
      "fn": "Si",
      "reverse": false,
      "domain": "社交人情",
      "text": "饭桌上那段子你讲了好几遍。"
    },
    {
      "id": "Si-11",
      "fn": "Si",
      "reverse": false,
      "domain": "消费生活",
      "text": "酱油一直买同一个牌子。"
    },
    {
      "id": "Si-12",
      "fn": "Si",
      "reverse": true,
      "domain": "消费生活",
      "text": "换新手机，你懒得把旧设置搬过来。"
    },
    {
      "id": "Si-13",
      "fn": "Si",
      "reverse": false,
      "domain": "冲突矛盾",
      "text": "邻里这点事，按以前的办法处理就行。"
    },
    {
      "id": "Si-14",
      "fn": "Si",
      "reverse": true,
      "domain": "冲突矛盾",
      "text": "跟同事闹别扭，你不去想上回怎么解决的。"
    },
    {
      "id": "Si-15",
      "fn": "Si",
      "reverse": false,
      "domain": "兴趣娱乐",
      "text": "跑步你走熟的那条路线。"
    },
    {
      "id": "Si-16",
      "fn": "Si",
      "reverse": true,
      "domain": "兴趣娱乐",
      "text": "做菜你不看量杯，也不掐表。"
    },
    {
      "id": "Si-17",
      "fn": "Si",
      "reverse": false,
      "domain": "信息媒体",
      "text": "看到传言，你想起前几年传过的那一版。"
    },
    {
      "id": "Si-18",
      "fn": "Si",
      "reverse": false,
      "domain": "亲密关系",
      "text": "你记得对方不吃什么、几点睡。"
    },
    {
      "id": "Si-19",
      "fn": "Si",
      "reverse": false,
      "domain": "身体健康",
      "text": "换季了，你留意身上反应和往年像不像。"
    },
    {
      "id": "Ne-01",
      "fn": "Ne",
      "reverse": false,
      "domain": "家庭亲戚",
      "text": "装修时你想把两种不搭的风格放一起试试。"
    },
    {
      "id": "Ne-02",
      "fn": "Ne",
      "reverse": false,
      "domain": "家庭亲戚",
      "text": "孩子问一句为什么，你能扯出一串别的。"
    },
    {
      "id": "Ne-03",
      "fn": "Ne",
      "reverse": true,
      "domain": "家庭亲戚",
      "text": "家里换家具，你按原来那套再买一份。"
    },
    {
      "id": "Ne-04",
      "fn": "Ne",
      "reverse": false,
      "domain": "职场办公",
      "text": "讨论新方向，你先抛三个点子，哪怕还很粗。"
    },
    {
      "id": "Ne-05",
      "fn": "Ne",
      "reverse": false,
      "domain": "职场办公",
      "text": "两个不搭的业务，你会想能不能凑成一个。"
    },
    {
      "id": "Ne-06",
      "fn": "Ne",
      "reverse": true,
      "domain": "职场办公",
      "text": "讨论方案，你只谈眼前这一种做法。"
    },
    {
      "id": "Ne-07",
      "fn": "Ne",
      "reverse": false,
      "domain": "学习考试",
      "text": "学一个新概念，你会想它还能用在哪。"
    },
    {
      "id": "Ne-08",
      "fn": "Ne",
      "reverse": true,
      "domain": "学习考试",
      "text": "学东西你按老师给的步骤走，不想别的用法。"
    },
    {
      "id": "Ne-09",
      "fn": "Ne",
      "reverse": false,
      "domain": "社交人情",
      "text": "聊天你容易跳题，朋友说你跳得有点快。"
    },
    {
      "id": "Ne-10",
      "fn": "Ne",
      "reverse": true,
      "domain": "社交人情",
      "text": "聊天你希望一直停在同一个话题上。"
    },
    {
      "id": "Ne-11",
      "fn": "Ne",
      "reverse": false,
      "domain": "消费生活",
      "text": "逛超市你专挑没见过的牌子试。"
    },
    {
      "id": "Ne-12",
      "fn": "Ne",
      "reverse": true,
      "domain": "消费生活",
      "text": "逛超市你只买用过的那几个牌子。"
    },
    {
      "id": "Ne-13",
      "fn": "Ne",
      "reverse": false,
      "domain": "冲突矛盾",
      "text": "吵起来你会提第三条路，两边都没想过。"
    },
    {
      "id": "Ne-14",
      "fn": "Ne",
      "reverse": true,
      "domain": "冲突矛盾",
      "text": "吵起来你只想把眼前这件事说清。"
    },
    {
      "id": "Ne-15",
      "fn": "Ne",
      "reverse": false,
      "domain": "兴趣娱乐",
      "text": "你想同时学三样乐器，哪个都放不下。"
    },
    {
      "id": "Ne-16",
      "fn": "Ne",
      "reverse": false,
      "domain": "兴趣娱乐",
      "text": "出去玩你想把几个方案拼在一起。"
    },
    {
      "id": "Ne-17",
      "fn": "Ne",
      "reverse": false,
      "domain": "信息媒体",
      "text": "看到新技术的新闻，你先想它还能用在哪。"
    },
    {
      "id": "Ne-18",
      "fn": "Ne",
      "reverse": false,
      "domain": "亲密关系",
      "text": "约会你想换个没试过的花样。"
    },
    {
      "id": "Ne-19",
      "fn": "Ne",
      "reverse": false,
      "domain": "身体健康",
      "text": "身体不舒服，你会想到好几种可能的原因。"
    },
    {
      "id": "Ni-01",
      "fn": "Ni",
      "reverse": false,
      "domain": "家庭亲戚",
      "text": "看亲戚家孩子，你会猜他十年后什么样。"
    },
    {
      "id": "Ni-02",
      "fn": "Ni",
      "reverse": false,
      "domain": "家庭亲戚",
      "text": "家里闹矛盾，你觉得根子在很早以前。"
    },
    {
      "id": "Ni-03",
      "fn": "Ni",
      "reverse": true,
      "domain": "家庭亲戚",
      "text": "亲戚家的事，你只看眼前这一件。"
    },
    {
      "id": "Ni-04",
      "fn": "Ni",
      "reverse": false,
      "domain": "职场办公",
      "text": "你能判断这个行业三年后往哪走。"
    },
    {
      "id": "Ni-05",
      "fn": "Ni",
      "reverse": false,
      "domain": "职场办公",
      "text": "项目刚立项，你就说出它可能死在哪一步。"
    },
    {
      "id": "Ni-06",
      "fn": "Ni",
      "reverse": true,
      "domain": "职场办公",
      "text": "项目你只关心这周要交的那部分。"
    },
    {
      "id": "Ni-07",
      "fn": "Ni",
      "reverse": false,
      "domain": "学习考试",
      "text": "一本书读完，你能用一句话说清它讲什么。"
    },
    {
      "id": "Ni-08",
      "fn": "Ni",
      "reverse": true,
      "domain": "学习考试",
      "text": "复习你按章节过，不太想整门课的主线。"
    },
    {
      "id": "Ni-09",
      "fn": "Ni",
      "reverse": false,
      "domain": "社交人情",
      "text": "见一个人第一面，你心里就有个整体判断。"
    },
    {
      "id": "Ni-10",
      "fn": "Ni",
      "reverse": true,
      "domain": "社交人情",
      "text": "一群人待着，你只顾说自己的。"
    },
    {
      "id": "Ni-11",
      "fn": "Ni",
      "reverse": false,
      "domain": "消费生活",
      "text": "买大件你会想它过几年会不会过时。"
    },
    {
      "id": "Ni-12",
      "fn": "Ni",
      "reverse": true,
      "domain": "消费生活",
      "text": "买东西你只看现在用不用得上。"
    },
    {
      "id": "Ni-13",
      "fn": "Ni",
      "reverse": false,
      "domain": "冲突矛盾",
      "text": "争执里你能指出两边真正的分歧在哪。"
    },
    {
      "id": "Ni-14",
      "fn": "Ni",
      "reverse": true,
      "domain": "冲突矛盾",
      "text": "争执里你只回他最后说的那一句。"
    },
    {
      "id": "Ni-15",
      "fn": "Ni",
      "reverse": false,
      "domain": "兴趣娱乐",
      "text": "看完电影，你想的是它真正在讲什么。"
    },
    {
      "id": "Ni-16",
      "fn": "Ni",
      "reverse": false,
      "domain": "兴趣娱乐",
      "text": "听一首歌，你脑子里会浮出一个画面。"
    },
    {
      "id": "Ni-17",
      "fn": "Ni",
      "reverse": false,
      "domain": "信息媒体",
      "text": "一条新闻，你会想它背后往哪走。"
    },
    {
      "id": "Ni-18",
      "fn": "Ni",
      "reverse": false,
      "domain": "亲密关系",
      "text": "关系里你常预感到这样下去会怎样。"
    },
    {
      "id": "Ni-19",
      "fn": "Ni",
      "reverse": false,
      "domain": "身体健康",
      "text": "长期累，你觉得身体在提示你什么。"
    },
    {
      "id": "Te-01",
      "fn": "Te",
      "reverse": false,
      "domain": "家庭亲戚",
      "text": "搬家你先列时间表，谁搬哪间写清楚。"
    },
    {
      "id": "Te-02",
      "fn": "Te",
      "reverse": false,
      "domain": "家庭亲戚",
      "text": "过年回谁家、哪天走，你排成一张表。"
    },
    {
      "id": "Te-03",
      "fn": "Te",
      "reverse": true,
      "domain": "家庭亲戚",
      "text": "家里出游到了再商量，事先不定计划。"
    },
    {
      "id": "Te-04",
      "fn": "Te",
      "reverse": false,
      "domain": "职场办公",
      "text": "接到任务，你先拆步骤、定截止时间。"
    },
    {
      "id": "Te-05",
      "fn": "Te",
      "reverse": false,
      "domain": "职场办公",
      "text": "开会到最后，你说清谁做、什么时候交。"
    },
    {
      "id": "Te-06",
      "fn": "Te",
      "reverse": true,
      "domain": "职场办公",
      "text": "项目走一步看一步，你不排节点。"
    },
    {
      "id": "Te-07",
      "fn": "Te",
      "reverse": false,
      "domain": "学习考试",
      "text": "备考你先排一张到考前的表。"
    },
    {
      "id": "Te-08",
      "fn": "Te",
      "reverse": true,
      "domain": "学习考试",
      "text": "复习你翻到哪算哪，不做安排。"
    },
    {
      "id": "Te-09",
      "fn": "Te",
      "reverse": false,
      "domain": "社交人情",
      "text": "组织聚会，你把时间、人数、地点定死。"
    },
    {
      "id": "Te-10",
      "fn": "Te",
      "reverse": false,
      "domain": "社交人情",
      "text": "群里收钱，你把账目和进度贴出来。"
    },
    {
      "id": "Te-11",
      "fn": "Te",
      "reverse": false,
      "domain": "消费生活",
      "text": "买大件你做张比价表，参数一起看。"
    },
    {
      "id": "Te-12",
      "fn": "Te",
      "reverse": true,
      "domain": "消费生活",
      "text": "买东西你看着顺眼就下单，不比价。"
    },
    {
      "id": "Te-13",
      "fn": "Te",
      "reverse": false,
      "domain": "冲突矛盾",
      "text": "吵完你把规矩重写一遍，免得再吵。"
    },
    {
      "id": "Te-14",
      "fn": "Te",
      "reverse": true,
      "domain": "冲突矛盾",
      "text": "有矛盾你等它自己过去，不另定规矩。"
    },
    {
      "id": "Te-15",
      "fn": "Te",
      "reverse": false,
      "domain": "兴趣娱乐",
      "text": "出去玩你先把每天的行程排出来。"
    },
    {
      "id": "Te-16",
      "fn": "Te",
      "reverse": true,
      "domain": "兴趣娱乐",
      "text": "组队打游戏，你等别人分位置。"
    },
    {
      "id": "Te-17",
      "fn": "Te",
      "reverse": false,
      "domain": "信息媒体",
      "text": "看新政策，你先找关键条款和执行时间。"
    },
    {
      "id": "Te-18",
      "fn": "Te",
      "reverse": false,
      "domain": "亲密关系",
      "text": "共同开销你记账，到月底对一次。"
    },
    {
      "id": "Te-19",
      "fn": "Te",
      "reverse": false,
      "domain": "身体健康",
      "text": "体检你按计划安排，复查时间也定好。"
    },
    {
      "id": "Ti-01",
      "fn": "Ti",
      "reverse": false,
      "domain": "家庭亲戚",
      "text": "家里争该不该，你先问清这个该是按谁的标准。"
    },
    {
      "id": "Ti-02",
      "fn": "Ti",
      "reverse": false,
      "domain": "家庭亲戚",
      "text": "说明书上的原理，你要读明白才动手。"
    },
    {
      "id": "Ti-03",
      "fn": "Ti",
      "reverse": true,
      "domain": "家庭亲戚",
      "text": "亲戚说的话对不对得上，你不去管。"
    },
    {
      "id": "Ti-04",
      "fn": "Ti",
      "reverse": false,
      "domain": "职场办公",
      "text": "方案里的逻辑漏洞，你一眼就指出来。"
    },
    {
      "id": "Ti-05",
      "fn": "Ti",
      "reverse": false,
      "domain": "职场办公",
